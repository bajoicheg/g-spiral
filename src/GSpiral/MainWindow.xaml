<Window x:Class="GSpiral.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GSpiral.Presentation"
        xmlns:controls="clr-namespace:GSpiral.Controls"
        Title="G-Spiral — Корпоративная культура"
        Icon="Assets/G-Spiral.ico"
        Width="1240" Height="840" MinWidth="940" MinHeight="680"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Background="#F4F6FA">
    <Window.Resources>
        <LinearGradientBrush x:Key="AppGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F5F7FF" Offset="0"/><GradientStop Color="#F4FBFA" Offset="0.55"/><GradientStop Color="#FFF9F2" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#26364A"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="20,10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="40"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.92"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Background" Value="#E8ECF2"/><Setter Property="Foreground" Value="#26364A"/></Style>
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Padding" Value="14,7"/><Setter Property="MinHeight" Value="34"/></Style>
        <Style x:Key="SavedButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding HasSavedReport}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ScreenStart" TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Screen}" Value="{x:Static vm:AppScreen.Start}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
        <Style x:Key="ScreenQuestion" TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Screen}" Value="{x:Static vm:AppScreen.Question}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
        <Style x:Key="ScreenResults" TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Screen}" Value="{x:Static vm:AppScreen.Results}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
        <Style x:Key="ProgressSegment" TargetType="Border"><Setter Property="Background" Value="#D8DEE8"/><Setter Property="Height" Value="6"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Margin" Value="3,0"/><Style.Triggers><DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True"><Setter Property="Background" Value="#4F46E5"/></DataTrigger></Style.Triggers></Style>
        <Style x:Key="ResultProgress" TargetType="ProgressBar"><Setter Property="Height" Value="9"/><Setter Property="Background" Value="#E9EDF2"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid ClipToBounds="True"><Border Background="{TemplateBinding Background}" CornerRadius="5"/><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="5"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppGradient}">
        <Grid Margin="34">
            <Grid Style="{StaticResource ScreenStart}">
                <Border MaxWidth="760" Background="White" CornerRadius="20" Padding="44" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Effect><DropShadowEffect BlurRadius="26" ShadowDepth="4" Opacity="0.12"/></Border.Effect>
                    <StackPanel>
                        <Grid><TextBlock Text="G-Spiral" FontSize="18" FontWeight="SemiBold" Foreground="#667085"/><Button Content="О программе" Click="About_Click" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"/></Grid>
                        <TextBlock Text="{Binding IdentityScreenTitle}" FontSize="34" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,12,0,6" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding IdentityScreenDescription}" FontSize="15.5" Foreground="#667085" TextWrapping="Wrap" Margin="0,0,0,24"/>
                        <TextBlock Text="Имя" FontWeight="SemiBold" Foreground="#475467" Margin="0,0,0,5"/><TextBox Text="{Binding RespondentName, UpdateSourceTrigger=PropertyChanged}" FontSize="17" Padding="12" MinHeight="48" BorderBrush="#C8D0DA"/>
                        <TextBlock Text="Компания" FontWeight="SemiBold" Foreground="#475467" Margin="0,17,0,5"/><TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" FontSize="17" Padding="12" MinHeight="48" BorderBrush="#C8D0DA"/>
                        <TextBlock Text="7 этапов. На каждом этапе можно выбрать любое количество независимых утверждений. Варианты показываются в случайном порядке." TextWrapping="Wrap" Foreground="#667085" Margin="0,20,0,0"/>
                        <Grid Margin="0,24,0,0"><Button Content="{Binding StartActionText}" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" IsDefault="True"/><TextBlock Text="{Binding AppVersionText}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#98A2B3"/></Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Style="{StaticResource ScreenQuestion}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#EEFFFFFF" CornerRadius="16" Padding="22" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid><TextBlock Text="{Binding CompanyName, StringFormat=Корпоративная культура — {0}}" Foreground="#667085"/><Button Content="О программе" Click="About_Click" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"/></Grid>
                        <TextBlock Text="{Binding QuestionProgressText}" FontSize="14" FontWeight="SemiBold" Foreground="#4F46E5" Margin="0,10,0,2"/>
                        <TextBlock Text="{Binding CurrentQuestionTitle}" FontSize="29" FontWeight="SemiBold" Foreground="#1F2937" TextWrapping="Wrap"/>
                        <Grid Margin="0,8,0,0"><TextBlock Text="Выберите все утверждения, которые подходят вашей компании. Принадлежность вариантов к типам скрыта." Foreground="#667085" TextWrapping="Wrap" Margin="0,0,330,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="{Binding CurrentQuestionSelectedCountText}" FontWeight="SemiBold" Foreground="#344054" VerticalAlignment="Center" Margin="0,0,10,0"/><Button Content="Выбрать всё" Command="{Binding SelectAllCommand}" Style="{StaticResource GhostButton}" Margin="0,0,6,0"/><Button Content="Снять всё" Command="{Binding ClearAllCommand}" Style="{StaticResource GhostButton}"/></StackPanel></Grid>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Background="#CFFFFFFF" CornerRadius="16" Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding CurrentOptions}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <ToggleButton IsChecked="{Binding IsSelected, Mode=TwoWay}" Width="340" MinHeight="94" Margin="7" BorderThickness="0" FocusVisualStyle="{x:Null}" AutomationProperties.Name="{Binding Text}">
                                    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Card" Background="{Binding DecorativeFill}" BorderBrush="{Binding DecorativeBorder}" BorderThickness="1.5" CornerRadius="13" Padding="17">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><TextBlock x:Name="OptionText" Text="{Binding Text}" TextWrapping="Wrap" FontSize="14.5" LineHeight="20" Foreground="#303846" VerticalAlignment="Center"/><Border Grid.Column="1" Width="26" Height="26" CornerRadius="13" Background="#24FFFFFF"><TextBlock x:Name="Check" Text="✓" FontSize="17" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/></Border></Grid>
                                        </Border>
                                        <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="Background" Value="{Binding DecorativeBorder}"/><Setter TargetName="Card" Property="BorderThickness" Value="3"/><Setter TargetName="Check" Property="Visibility" Value="Visible"/><Setter TargetName="OptionText" Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Opacity" Value="0.93"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#111827"/><Setter TargetName="Card" Property="BorderThickness" Value="3"/></Trigger></ControlTemplate.Triggers>
                                    </ControlTemplate></ToggleButton.Template>
                                </ToggleButton>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
                <Border Grid.Row="2" Background="#EEFFFFFF" CornerRadius="14" Padding="16,13" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="← Назад" Command="{Binding BackCommand}" Style="{StaticResource SecondaryButton}"/><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Border Width="48" Style="{StaticResource ProgressSegment}" Tag="{Binding Progress1}"/><Border Width="48" Style="{StaticResource ProgressSegment}" Tag="{Binding Progress2}"/><Border Width="48" Style="{StaticResource ProgressSegment}" Tag="{Binding Progress3}"/><Border Width="48" Style="{StaticResource ProgressSegment}" Tag="{Binding Progress4}"/><Border Width="48" Style="{StaticResource ProgressSegment}" Tag="{Binding Progress5}"/><Border Width="48" Style="{StaticResource ProgressSegment}" Tag="{Binding Progress6}"/><Border Width="48" Style="{StaticResource ProgressSegment}" Tag="{Binding Progress7}"/></StackPanel><Button Grid.Column="2" Content="{Binding NextButtonText}" Command="{Binding NextCommand}" Style="{StaticResource PrimaryButton}"/></Grid></Border>
            </Grid>

            <Grid Style="{StaticResource ScreenResults}">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,7,7">
                    <Border Background="#EEFFFFFF" CornerRadius="16" Padding="22" Margin="0,0,0,12"><Grid><StackPanel><TextBlock Text="Результаты" FontSize="30" FontWeight="SemiBold" Foreground="#1F2937"/><TextBlock Text="{Binding IdentitySummaryText}" Foreground="#667085" Margin="0,4,0,0"/><TextBlock Text="{Binding TotalSelectionsText}" Foreground="#98A2B3" FontSize="12.5"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><Button Content="Изменить имя и компанию" Command="{Binding EditIdentityCommand}" Style="{StaticResource GhostButton}" Margin="0,0,7,0"/><Button Content="О программе" Click="About_Click" Style="{StaticResource GhostButton}"/></StackPanel></Grid></Border>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition Width="0.92*"/></Grid.ColumnDefinitions>
                        <Border Background="White" CornerRadius="16" Padding="22" Margin="0,0,7,0"><StackPanel><TextBlock Text="Итоги по типам" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding ResultsPercentExplanation}" Foreground="#667085" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,10"/><ItemsControl ItemsSource="{Binding Results}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="175"/></Grid.ColumnDefinitions><Border Width="12" Height="12" CornerRadius="6" Background="{Binding PrimaryHex}"/><TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/><ProgressBar Grid.Column="2" Minimum="0" Maximum="1" Value="{Binding BarFraction}" Foreground="{Binding PrimaryHex}" Style="{StaticResource ResultProgress}" Margin="8,0,12,0" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{Binding ScoreAndPercentText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#4B5563"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                        <Border Grid.Column="1" Background="White" CornerRadius="16" Padding="22" Margin="7,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Структура набранных баллов" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding PieShareExplanation}" Foreground="#667085" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel><Grid Grid.Row="1" MinHeight="300"><controls:Pie3DChartControl Items="{Binding Results}"><controls:Pie3DChartControl.Style><Style TargetType="controls:Pie3DChartControl"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasSelections}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></controls:Pie3DChartControl.Style></controls:Pie3DChartControl><TextBlock Text="Нет выбранных соответствий" Foreground="#667085" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasSelections}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><ItemsControl Grid.Row="2" ItemsSource="{Binding Results}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="0,2,12,2"><Border Width="9" Height="9" CornerRadius="5" Background="{Binding PrimaryHex}" Margin="0,0,5,0"/><TextBlock Text="{Binding Name}" FontSize="12" Foreground="#4B5563"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></Border>
                    </Grid>
                    <Border Background="White" CornerRadius="16" Padding="22" Margin="0,12,0,0"><StackPanel><TextBlock Text="Ваши ответы" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Выбранные утверждения приведены в порядке предъявления." Foreground="#667085" Margin="0,3,0,10"/><ItemsControl ItemsSource="{Binding StageAnswerSummaries}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#F8FAFC" CornerRadius="11" Padding="14" Margin="0,5"><StackPanel><Grid><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding CountText}" HorizontalAlignment="Right" Foreground="#667085"/></Grid><ItemsControl ItemsSource="{Binding SelectedTexts}" Margin="0,6,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat=✓ {0}}" TextWrapping="Wrap" Foreground="#475467" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                </StackPanel></ScrollViewer>
                <Border Grid.Row="1" Background="#F5FFFFFF" CornerRadius="14" Padding="14" Margin="0,9,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="Сохранить XLSX" Click="SaveReport_Click" Style="{StaticResource PrimaryButton}"/><Button Grid.Column="1" Content="Открыть файл" Click="OpenSavedReport_Click" Style="{StaticResource SavedButton}" Margin="7,0,0,0"/><Button Grid.Column="2" Content="Открыть папку" Click="OpenSavedFolder_Click" Style="{StaticResource SavedButton}" Margin="7,0,0,0"/><Button Grid.Column="4" Content="Назад к ответам" Command="{Binding BackToAnswersCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,7,0"/><Button Grid.Column="5" Content="Пройти заново" Command="{Binding RestartCommand}" Style="{StaticResource SecondaryButton}"/></Grid></Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
